# Configure estas variáveis em Vercel > Project Settings > Environment Variables.
# Este arquivo é um exemplo; settings.py usa o ambiente do processo.
DB_HOST=seu-servidor-mysql
DB_PORT=3306
DB_NAME=sao_gabriel
DB_USER=seu-usuario
DB_PASSWORD=sua-senha
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=sao-gabriel-blue.vercel.app

# Certificado CA baixado na Aiven, incluído junto da aplicação.
DB_SSL_CA=ca.pem
